# ─── Server ──────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── JWT Key Rotation (optional) ─────────────────────
# Keys are auto-generated RSA-2048 and stored in the database.
# No static secrets needed.
# KEY_ROTATION_HOURS=24     # How often to rotate (default: 24h)
# KEY_GRACE_HOURS=48        # How long old keys stay valid (default: 48h)

# ─── Google OAuth ─────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id

# ─── Frontend ────────────────────────────────────────
FRONTEND_URL=http://localhost:8100
